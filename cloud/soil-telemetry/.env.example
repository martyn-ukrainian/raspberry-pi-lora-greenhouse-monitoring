# Локальний запуск. На Vercel ці ж дві змінні задаються в Project → Settings →
# Environment Variables; .env туди не їде.

# Neon: Connection string з увімкненим "Pooled connection". Pooled обов'язково:
# кожен виклик функції відкриває своє з'єднання, а прямий ліміт у Neon малий.
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Той самий рядок, що в прошивці (INGEST_TOKEN у firmware/.env). Порожній =
# перевірка вимкнена — допустимо лише локально.
INGEST_TOKEN=

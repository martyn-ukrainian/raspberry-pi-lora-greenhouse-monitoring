# Облікові дані для польового/Wi-Fi режиму soil-calibration.
#
# Скопіювати в .env і заповнити. Сам .env у .gitignore — паролі в репозиторії
# не живуть, і в історії команд оболонки теж (Makefile читає файл, а не
# приймає їх аргументом).
#
#   cp .env.example .env
#   make upload PROJECT=soil-calibration PIO_ENV=wifi_field

WIFI_SSID=TP-Link_1AFF
WIFI_PASS=

# Куди плата шле пачки.
#   фаза 0 / звірка — локальний приймач: http://<IP ноута>:8008/api/ingest
#   бойовий режим   — https://<проєкт>.vercel.app/api/ingest
# Адресу для локального приймача друкує сам tools/ingest_sink.py при старті.
INGEST_URL=http://192.168.0.100:8008/api/ingest

# Порожній = приймач не перевіряє. Для хмари обов'язковий.
INGEST_TOKEN=
